    "clsx": "^2.1.1",
    "contentlayer2": "0.5.8",
    "date-fns": "^4.4.0",
    "framer-motion": "^12.43.0",
    "gray-matter": "^4.0.3",
    "lucide-react": "^0.562.0",
    "next": "^16.4.6",
    "next-contentlayer2": "0.5.8",
    "next-themes": "^0.4.6",
    "react": "^19.3.1",
