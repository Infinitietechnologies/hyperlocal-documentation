    "@types/node": "^25.9.9",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/react-syntax-highlighter": "^15.5.13",
    "autoprefixer": "^10.6.2",
    "concurrently": "^9.2.5",
    "eslint": "^9.39.5",
